generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ALUNO
  PROFESSOR
  ADMIN
}

enum UserStatus {
  PENDENTE
  ATIVO
  SUSPENSO
  BLOQUEADO
}

enum PostType {
  NORMAL
  NOTICIA
  PROJETO
  EVENTO
}

enum ReportReason {
  BULLYING
  INSULTO
  AMEACA
  OFENSIVO
  IMPROPRIO
  SPAM
  OUTRO
}

enum ReportStatus {
  ABERTA
  EM_ANALISE
  RESOLVIDA
  REJEITADA
}

enum ReactionType {
  LIKE
  LOVE
  SUPPORT
}

enum ReportTargetType {
  POST
  COMMENT
}

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  studentNumber  String     @unique
  course         String
  classGroup     String
  passwordHash   String
  role           Role       @default(ALUNO)
  status         UserStatus @default(PENDENTE)
  bio            String?
  avatarUrl      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  posts          Post[]
  comments       Comment[]
  reactions      Reaction[]
  reports        Report[]   @relation("Reporter")
  reviewedReports Report[]  @relation("Reviewer")
  sentMessages     DirectMessage[] @relation("SentMessages")
  receivedMessages DirectMessage[] @relation("ReceivedMessages")
  notifications    Notification[]
  groupMemberships GroupMember[]
}

model Post {
  id        String    @id @default(uuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String
  type      PostType  @default(NORMAL)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  comments  Comment[]
  reactions Reaction[]
}

model Comment {
  id        String    @id @default(uuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id])
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

model Reaction {
  id        String       @id @default(uuid())
  postId    String
  post      Post         @relation(fields: [postId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
}

model Report {
  id              String           @id @default(uuid())
  targetType      ReportTargetType
  targetId        String
  reporterId      String
  reporter        User             @relation("Reporter", fields: [reporterId], references: [id])
  reason          ReportReason
  description     String?
  status          ReportStatus     @default(ABERTA)
  reviewerId      String?
  reviewer        User?            @relation("Reviewer", fields: [reviewerId], references: [id])
  resolutionNote  String?
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?
}

model DirectMessage {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id])
  content     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, readAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model CommunityGroup {
  id          String        @id @default(uuid())
  name        String
  description String?
  members     GroupMember[]
}

model GroupMember {
  id       String         @id @default(uuid())
  groupId  String
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime       @default(now())

  @@unique([groupId, userId])
}

model SchoolEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
}

model ResourceLink {
  id          String @id @default(uuid())
  title       String
  url         String
  category    String
  description String?
  sortOrder   Int    @default(0)
}
